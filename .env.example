# ==============================================================================
# DOCTOR G — ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Copy this file to .env.local or set these variables in your deployment platform
# (Vercel / Netlify / Cloudflare Pages / Railway / AWS).

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Get these credentials from your Supabase Project Settings -> API:
# https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ------------------------------------------------------------------------------
# 2. RAZORPAY PAYMENT GATEWAY
# ------------------------------------------------------------------------------
# Get your Razorpay Key ID from the Razorpay Dashboard -> Settings -> API Keys:
# https://dashboard.razorpay.com/app/keys
# Note: Keep RAZORPAY_KEY_SECRET strictly server-side / in edge functions!
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id

# ------------------------------------------------------------------------------
# 3. GOOGLE MAPS JAVASCRIPT API & PLACES
# ------------------------------------------------------------------------------
# Get your Google Maps API Key from the Google Cloud Console:
# https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Places API, Directions API, Geocoding API
VITE_GOOGLE_MAPS_API_KEY=AIzaSyYourGoogleMapsApiKeyHere

# ------------------------------------------------------------------------------
# 4. GOOGLE CALENDAR & OAUTH
# ------------------------------------------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# ------------------------------------------------------------------------------
# 5. ENVIRONMENT MODE
# ------------------------------------------------------------------------------
VITE_APP_ENV=production
